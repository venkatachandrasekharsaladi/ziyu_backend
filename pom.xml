<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   LoveOS API — Spring Boot 4 / Java 21
  ============================================================================

  This is the only active LoveOS backend. The former Node implementation is
  retired and receives no new work. Stable HTTP contracts remain compatible
  with the Expo client while their maintained documentation moves here.

  VERSIONS ARE PINNED TO WHAT IS ALREADY IN ~/.m2. Every version below was
  verified present in the local repository before being written here, so a first
  build succeeds even if Artifactory is slow or briefly unavailable.

  Build:  mvn package
  Run:    mvn spring-boot:run -Dspring-boot.run.profiles=pgdev
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ===================================================================== -->
  <!--  Parent — supplies dependency management and sane plugin defaults     -->
  <!-- ===================================================================== -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <!-- ===================================================================== -->
  <!--  Coordinates                                                          -->
  <!-- ===================================================================== -->

  <groupId>com.loveos</groupId>
  <artifactId>loveos-api</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>LoveOS API</name>
  <description>Backend for the LoveOS couples app</description>

  <!-- ===================================================================== -->
  <!--  Properties                                                           -->
  <!-- ===================================================================== -->

  <properties>
    <java.version>21</java.version>

    <!--
      Encoding is set explicitly rather than inherited. The default is the
      platform charset, which on Windows is cp1252 — the same source tree would
      then compile differently here and on CI, and the non-ASCII characters in
      the console mailer's output would be mangled on one of them.
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      THE ENTRY POINT. Boot's repackager scans for a main class and would find
      this one anyway, but naming it means a second `public static void main`
      added later cannot silently change what the jar launches. It is also what
      an IDE reads to offer the right run configuration on import.
    -->
    <start-class>com.loveos.api.LoveOsApplication</start-class>

    <!-- Dependency versions not managed by the Boot parent. -->
    <jjwt.version>0.12.6</jjwt.version>
  </properties>

  <!-- ===================================================================== -->
  <!--  Dependencies                                                         -->
  <!-- ===================================================================== -->

  <dependencies>

    <!-- ~~ Web ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!--
      Bean Validation. Not optional: every request record is annotated, and
      without this on the classpath `@Valid` is silently ignored rather than
      failing loudly — the trust boundary would quietly stop existing.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ~~ Persistence ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      PostgreSQL is the ONLY database on the classpath, deliberately.

      An in-memory H2 used to live here for a no-install `local` profile. It was
      removed because a substitute database is worse than no database: the two
      engines disagree on JSONB, arrays, upsert semantics, case folding and
      timestamp handling, so code that passes against H2 can still fail against
      Postgres — and, far more confusingly, rows can appear to save while the
      real database never sees them. With only this driver present that class of
      mistake is impossible rather than merely discouraged.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway owns every schema change. Hibernate only validates the result; it
      never creates or updates a production table. PostgreSQL support is a
      separate Flyway module in current releases, hence both artifacts.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- ~~ Security ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!--
      Used for the password encoder and the filter chain only. Session
      management is stateless and the app issues its own JWTs rather than using
      Spring Session, because the client is a mobile app with no cookie jar.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      JJWT, split across three artifacts on purpose: `api` is compile-scope and
      is all application code ever sees; `impl` and `jackson` are runtime-only,
      so nothing can accidentally couple to an implementation class that the
      library is free to change between minor versions.
    -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- ~~ Mail ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Production Media adapter. Credentials use the AWS default provider
         chain; S3-compatible endpoints may be supplied through configuration. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.47.0</version>
    </dependency>

    <!-- ~~ Build-time only ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!--
      A real PostgreSQL server, run from Java, for the `pgdev` profile.

      This machine has PostgreSQL installed but no service registered and no
      superuser password, and creating either needs administrator rights. These
      artifacts carry the genuine PostgreSQL binaries and run them as a child
      process under the current user account — same engine, same SQL, no service,
      no elevation, and a password this project chooses for itself.

      DEVELOPMENT ONLY. Excluded from the packaged jar below, because a server
      that starts itself is exactly what a deployment must never do: the database
      belongs to the environment, not to the application.
    -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>2.0.7</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
      <version>16.2.0</version>
      <optional>true</optional>
    </dependency>

    <!--
      Lombok is a compile-time annotation processor; nothing it generates
      references it at runtime. `optional` keeps it off the compile classpath of
      anything depending on this module, and the repackage exclusion below keeps
      it out of the jar entirely.
    -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ~~ Test ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- ===================================================================== -->
  <!--  Build                                                                -->
  <!-- ===================================================================== -->

  <build>
    <finalName>${project.artifactId}</finalName>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>${start-class}</mainClass>
        </configuration>

        <!--
          THE EXCLUSIONS BELONG TO `repackage`, NOT TO THE PLUGIN.

          Configuration placed directly on the plugin applies to every goal it
          has, including `run` — which would strip these libraries from the very
          classpath the pgdev profile needs and fail at startup with a
          NoClassDefFoundError that says nothing about Maven. Scoping them to the
          packaging step keeps `mvn spring-boot:run` complete while still keeping
          the jar clean.
        -->
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                Neither of these belongs in a deployable artifact. Lombok has no
                runtime role at all, and a self-starting database server is the
                opposite of what a deployed application should contain: the
                database belongs to the environment, not to the process.
              -->
              <excludes>
                <exclude>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                </exclude>
                <exclude>
                  <groupId>io.zonky.test</groupId>
                  <artifactId>embedded-postgres</artifactId>
                </exclude>
                <exclude>
                  <groupId>io.zonky.test.postgres</groupId>
                  <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                </exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Lombok must be declared as an annotation processor explicitly. Once any
        <annotationProcessorPaths> entry exists the compiler stops discovering
        processors from the classpath, so a processor added later without being
        listed here would simply stop running — producing "cannot find symbol:
        getEmail()" against code that compiled yesterday.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
