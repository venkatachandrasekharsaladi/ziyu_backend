meta {
  name: Login - wrong password
  type: http
  seq: 1
}

post {
  url: {{ziyuBaseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "definitely-not-it-9"
  }
}

docs {
  Compare this response — and its timing — with "Login - unknown account".
  They are deliberately identical, so the endpoint cannot be used to discover
  which addresses have accounts.
}

assert {
  res.status: eq 401
  res.body.error.code: eq INVALID_CREDENTIALS
}
