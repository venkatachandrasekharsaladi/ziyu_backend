meta {
  name: Forgot Password
  type: http
  seq: 9
}

post {
  url: {{ziyuBaseUrl}}/v1/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  Always 202, for any valid address. Try it with nobody@example.com — the
  response is identical, because a different answer would turn this endpoint
  into a membership oracle.

  The reset link is printed by the console mailer; copy its token into
  `resetToken`.
}

assert {
  res.status: eq 202
  res.body.data.accepted: eq true
}
