meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{ziyuBaseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.expiresIn: eq 900
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.refreshToken);
  }
}
