meta {
  name: Reset Password
  type: http
  seq: 10
}

post {
  url: {{ziyuBaseUrl}}/v1/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{newPassword}}"
  }
}

docs {
  Single use, and revokes every existing session. No session is returned —
  whoever did this proved control of the inbox, not of the account.

  Afterwards, update `password` in the environment to `newPassword` or Login
  will start failing.
}

assert {
  res.status: eq 200
  res.body.data.reset: eq true
}
